{
  "rules": {
    ".read": false,
    ".write": false,

    "visits": {
      ".read": true,
      ".write": "newData.isNumber() && (!data.exists() ? newData.val() == 1 : newData.val() == data.val() + 1)"
    },

    "presence": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['s', 't']) && newData.child('s').isString() && newData.child('s').val().length <= 24 && newData.child('t').isNumber()",
        "s": { ".validate": "newData.isString()" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
